function BRPlayerCharacterBase:SwitchWeaponCheck(S, I)
  if self:HasState(EPawnState.AttachToOther) then
    local W = self:GetWeaponBySlot(S)
    if slua.isValid(W) then
      local id = W:GetWeaponID()
      local c = GamePlayTools.GetCurrentConfig("AttachToOtherConfig")
      if c and c.CheckIsWeaponInBlackList and c.CheckIsWeaponInBlackList(id) then
        local pc = self:GetPlayerControllerSafety()
        if Client and slua.isValid(pc) and pc.Role == ENetRole.ROLE_AutonomousProxy then
          pc:DisplayGameTipWithMsgID(47306)
        end
        return false
      end
    end
  end
  if self:HasState(EPawnState.WebSwing) and S ~= ESurviveWeaponPropSlot.SWPS_None and slua.isValid(self.STCharacterMovement) then
    local o = self.STCharacterMovement:GetSpecialMoveObjBySpecialMoveType(ESpecialMovementType.SPECIAL_MOVE_SpiderSwing)
    if slua.isValid(o) then
      local st = o:GetCurMoveState()
      if st == ESpiderSwingMoveState.Launching or st == ESpiderSwingMoveState.Swinging then return false end
    end
  end
  return self.Super:SwitchWeaponCheck(S, I)
end

