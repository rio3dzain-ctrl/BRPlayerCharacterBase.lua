function ESP.CanvasCenterX(viewW)
  local cw = nil
  pcall(function()
    local canvas = ESP.GetCanvas()
    if ESPValid(canvas) then
      local g = canvas:GetCachedGeometry()
      if g and g.GetLocalSize then
        local s = g:GetLocalSize()
        if s and tonumber(s.X) and s.X > 1 then cw = tonumber(s.X) end
      end
    end
  end)
  if tonumber(cw) and cw > 1 then return cw * 0.5 end
  return (viewW * 0.5) * (ESP.ScaleX or 1) + (ESP.OffsetX or 0)
end

function ESP.UpdateCounter(np, nb, viewW)
  local d = ESP.Counter
  if not d or not ESPValid(d.Container) then
    ESP.Destroy(d) d = ESP.CreateCounter() ESP.Counter = d
  end
  if not d then return nil end
  local lab = string.format("Players: %d | Bots: %d | FPS: %d [%d]", np or 0, nb or 0, math.floor(ESP.DetectedFPS or 0), math.floor(ESP._cap or CFG.MaxTracked))
  pcall(function() if d.Last ~= lab then d.Text:SetText(lab) d.Last = lab end end)
  local cx = ESP.CanvasCenterX(viewW)
  if cx then
    cx = RND(cx)
    if d.px == nil or math.abs(d.px - cx) >= 1.0 then
      d.px = cx
      pcall(function() d.Slot:SetPosition(ESPV2(cx, CFG.TopTextY)) d.Container:SetWidgetVisibility(UEnums.ESlateVisibility.SelfHitTestInvisible) end)
    else
      pcall(function() d.Container:SetWidgetVisibility(UEnums.ESlateVisibility.SelfHitTestInvisible) end)
    end
  end
  return ESPV2(cx or 0, CFG.SnapOriginY)
end

function ESP.CreateInfo()
  local canvas = ESP.GetCanvas()
  if not ESPValid(canvas) then return nil end
  local c, tb, tn, td, ts = nil, nil, nil, nil, nil
  pcall(function() c = CGame:NewObjectFromPath("/Script/UMG.CanvasPanel", canvas) end)
  if not ESPValid(c) then return nil end
  pcall(function() tb = CGame:NewObjectFromPath("/Script/UMG.Border", c) end)
  pcall(function() tn = CGame:NewObjectFromPath("/Script/UMG.TextBlock", c) end)
  pcall(function() td = CGame:NewObjectFromPath("/Script/UMG.TextBlock", c) end)
  pcall(function() ts = CGame:NewObjectFromPath("/Script/UMG.TextBlock", c) end)
  if not ESPValid(tb) or not ESPValid(tn) or not ESPValid(td) or not ESPValid(ts) then
    ESP.Destroy({ Widget = c }) return nil
  end
  pcall(function()
    tb:SetBrushColor(TEAM_COLORS[1]) tb:SetWidgetVisibility(UEnums.ESlateVisibility.SelfHitTestInvisible)
    tn:SetText("Player") td:SetText("0m") ts:SetText("Open")
    tn:SetWidgetVisibility(UEnums.ESlateVisibility.SelfHitTestInvisible)
    td:SetWidgetVisibility(UEnums.ESlateVisibility.SelfHitTestInvisible)
    ts:SetWidgetVisibility(UEnums.ESlateVisibility.SelfHitTestInvisible)
    if tn.SetJustification then tn:SetJustification(1) end
    if td.SetJustification then td:SetJustification(1) end
    if ts.SetJustification then ts:SetJustification(1) end
  end)
  ESP.SetColor(tn, C_WHITE) ESP.SetColor(td, C_WHITE) ESP.SetColor(ts, C_GREEN)
  ESP.SetFont(tn, CFG.NameFontSize) ESP.SetFont(td, CFG.DistFontSize) ESP.SetFont(ts, CFG.StateFontSize)
  local bs, ns, s2, s3, ms = nil, nil, nil, nil, nil
  pcall(function() bs = c:AddChildToCanvas(tb) end)
  pcall(function() ns = c:AddChildToCanvas(tn) end)
  pcall(function() s2 = c:AddChildToCanvas(td) end)
  pcall(function() s3 = c:AddChildToCanvas(ts) end)
  pcall(function() ms = canvas:AddChildToCanvas(c) end)
  if not bs or not ns or not s2 or not s3 or not ms then ESP.Destroy({ Widget = c }) return nil end
  pcall(function()
    bs:SetAutoSize(false) bs:SetSize(ESPV2(120,22)) bs:SetAlignment(ESPV2(0.5,0.5)) bs:SetZOrder(34)
    ns:SetAutoSize(false) ns:SetSize(ESPV2(120,22)) ns:SetAlignment(ESPV2(0.5,0.5)) ns:SetZOrder(36)
    s2:SetAutoSize(true) s2:SetAlignment(ESPV2(0.5,0.5)) s2:SetZOrder(36)
    s3:SetAutoSize(true) s3:SetAlignment(ESPV2(0.5,0.5)) s3:SetZOrder(36)
    ms:SetAutoSize(false) ms:SetZOrder(35)
  end)
  return { Container = c, TeamBox = tb, Name = tn, Dist = td, State = ts, S0=bs, S1=ns, S2=s2, S3=s3, Slot=ms }
end

function ESP.UpdateInfo(key, c, bot, tid, dm, bVis, hx, hy)
  local d = ESP.Infos[key]
  if not d or not ESPValid(d.Container) then ESP.Destroy(d) d = ESP.CreateInfo() ESP.Infos[key] = d end
  if not d then return end
  local n = d.CachedName
  if not n then n = ESP.ResolveName(c, bot) d.CachedName = n end
  if bot then n = "Bot" d.CachedName = "Bot" end
  local dl = string.format("%dm", math.max(0, math.floor((tonumber(dm) or 0)+0.5)))
  local st = bVis and "Open" or "Close"
  local tc = TeamColor(tid, bot, key)
  pcall(function()
    if d.LastN ~= n then d.Name:SetText(n) d.LastN = n end
    if d.LastD ~= dl then d.Dist:SetText(dl) d.LastD = dl end
    if d.LastS ~= st then d.State:SetText(st) d.LastS = st end
    if d.LastTeam ~= tostring(tid)..":"..tostring(bot) then d.TeamBox:SetBrushColor(tc) d.LastTeam = tostring(tid)..":"..tostring(bot) end
    if bVis then ESP.SetColor(d.State, C_GREEN) else ESP.SetColor(d.State, C_RED) end
  end)
  local bw, bh = 100.0, 22.0
  local bx, by = RND(hx), RND(hy - 18.0)
  pcall(function()
    d.Slot:SetPosition(ESPV2(bx, by))
    d.Slot:SetSize(ESPV2(bw, 70.0))
    d.S0:SetPosition(ESPV2(0,0)) d.S0:SetSize(ESPV2(bw,bh))
    d.S1:SetPosition(ESPV2(0,0)) d.S1:SetSize(ESPV2(bw,bh))
    d.S2:SetPosition(ESPV2(bw*0.5, bh+12)) d.S3:SetPosition(ESPV2(bw*0.5, bh+30))
    d.Container:SetWidgetVisibility(UEnums.ESlateVisibility.SelfHitTestInvisible)
  end)
end

function ESP.EnsureHealthBg(key)
  local d = ESP.HealthBg[key]
  if d and ESPValid(d.Widget) then return d end
  d = ESP.NewLine(ESPMKC(0,0,0,CFG.SideBgAlpha), 31) ESP.HealthBg[key] = d return d
end

function ESP.EnsureHealthFill(key)
  local d = ESP.HealthFill[key]
  if d and ESPValid(d.Widget) then return d end
  d = ESP.NewLine(C_GREEN, 32) ESP.HealthFill[key] = d return d
end

function ESP.UpdateHealthBar(key, pct, x, y, w)
  local bg = ESP.EnsureHealthBg(key) local fl = ESP.EnsureHealthFill(key)
  if not bg or not fl then return end
  w = math.max(1, tonumber(w) or 1)
  ESP.DrawLine(bg, x, y, x+w, y, CFG.SideBarWidth)
  pct = tonumber(pct) or 1.0
  if pct < 0 then pct = 0 end
  if pct > 1 then pct = 1 end
  local bk
  if pct >= 0.7 then bk = "g"..math.floor(pct*20+0.5)
  elseif pct >= 0.4 then bk = "y"..math.floor(pct*20+0.5)
  else bk = "r"..math.floor(pct*20+0.5) end
  ESP.SetBrush(fl, HealthColor(pct), bk)
  local fw = w * pct
  if fw < 1 then ESP.Hide(fl) return end
  ESP.DrawLine(fl, x, y, x+fw, y, CFG.SideBarWidth)
end

function ESP.EnsureSnap(key)
  local d = ESP.Lines[key]
  if d and ESPValid(d.Widget) then return d end
  d = ESP.NewLine(C_GREEN, 30) ESP.Lines[key] = d return d
end

function ESP.HideTarget(key)
  local c = ESP.Corners[key]
  if c then for i = 1, 8 do ESP.Hide(c[i]) end end
  ESP.Hide(ESP.HealthBg[key]) ESP.Hide(ESP.HealthFill[key]) ESP.Hide(ESP.Lines[key])
  local inf = ESP.Infos[key]
  if inf and ESPValid(inf.Container) then
    pcall(function() inf.Container:SetWidgetVisibility(UEnums.ESlateVisibility.Collapsed) end)
  end
end

function ESP.ReleaseTarget(key)
  local c = ESP.Corners[key]
  if c then for i = 1, 8 do ESP.Destroy(c[i]) end end
  ESP.Corners[key] = nil
  ESP.Destroy(ESP.HealthBg[key]) ESP.HealthBg[key] = nil
  ESP.Destroy(ESP.HealthFill[key]) ESP.HealthFill[key] = nil
  ESP.Destroy(ESP.Lines[key]) ESP.Lines[key] = nil
  ESP.Destroy(ESP.Infos[key]) ESP.Infos[key] = nil
  ESP.VisCache[key] = nil
end

function ESP.ResetWidgets()
  for _, d in pairs(ESP.Lines) do ESP.Destroy(d) end
  for _, t in pairs(ESP.Corners) do for _, d in pairs(t) do ESP.Destroy(d) end end
  for _, d in pairs(ESP.HealthBg) do ESP.Destroy(d) end
  for _, d in pairs(ESP.HealthFill) do ESP.Destroy(d) end
  for _, d in pairs(ESP.Marks) do for _, d in pairs(d) do ESP.Destroy(d) end end
  for _, d in pairs(ESP.Infos) do ESP.Destroy(d) end
  ESP.Lines = {} ESP.Corners = {} ESP.HealthBg = {} ESP.HealthFill = {} ESP.Marks = {} ESP.Infos = {} ESP.VisCache = {}
  if ESP.Counter then ESP.Destroy(ESP.Counter) end
  ESP.Counter = nil ESP.Canvas = nil ESP.EnemyCache = {}
end

function ESP.Scan()
  local pc = ESP.GetController() local me = ESP.GetLocalCharacter()
  if not pc or not me then ESP.EnemyCache = {} return pc, 0, 0 end
  local ml = ESP.ActorLocation(me)
  if not ml then ESP.EnemyCache = {} return pc, 0, 0 end
  local mt = ESP.GetTeamID(me)
  local list = {}
  local nR, nB = 0, 0
  local all = ESP.GetAllCharacters()
  local seen = {}
  for _, ch in pairs(all) do
    if ESPValid(ch) and ch ~= me and ESP.IsAlive(ch) then
      local k = ESP.GetPlayerKey(ch)
      if not seen[k] then
        local t = ESP.GetTeamID(ch)
        if not (mt ~= nil and t ~= nil and tostring(t) == tostring(mt)) then
          local l = ESP.ActorLocation(ch)
          local dm = ESP.DistMeters(ml, l)
          seen[k] = true
          local b = ESP.IsBot(ch)
          if b then nB = nB+1 else nR = nR+1 end
          list[#list+1] = { Character=ch, Key=k, IsBot=b, TeamID=t, Distance=dm }
        end
      end
    end
  end
  table.sort(list, function(a,b) return (a.Distance or 99999) < (b.Distance or 99999) end)
  local effMax = math.min(ESP.GetAdaptiveMaxTracked(), ESP._cap or CFG.MaxTracked)
  local tr = {}
  for i, it in ipairs(list) do if i > effMax then break end tr[#tr+1] = it end
  ESP.EnemyCache = tr
  return pc, nR, nB
end

function ESP.Update()
  if not ESP_Enabled then ESP.ResetWidgets() return end

  local now = ESP.Now()

  -- FPS detect every 0.5s
  if (now - (ESP.FPSDetectTimer or 0)) >= (CFG.DetectEverySec or 0.5) then
    local fps = ESP.DetectDeviceFPS()
    if fps then
      ESP.DetectedFPS = fps
      ESP.TargetInterval = 1.0 / fps
    end
    ESP.FPSDetectTimer = now
  end

  -- Work gate: only process when target interval elapsed
  if (now - (ESP.LastWork or 0)) < (ESP.TargetInterval or (1/60)) * 0.7 then
    return
  end
  ESP.LastWork = now

  local tStart = now

  local world = ESP.World()
  if world ~= ESP.LastWorld then
    ESP.ResetWidgets()
    ESP.LastWorld = world
    ESP.LastScan = -999.0
    ESP.LastTransform = -999.0
    ESP._cap = ESP.GetAdaptiveMaxTracked()
    ESP._fastFrames = 0
  end
  local canvas = ESP.GetCanvas()
  if not canvas then return end
  local pc = ESP.GetController()
  if (now - ESP.LastScan) >= (ESP.ScanInterval or 0.3) then
    local r, b
    pc, r, b = ESP.Scan()
    ESP.LastScan = now
    ESP.RealCount, ESP.BotCount = r or 0, b or 0
  end
  pc = pc or ESP.GetController()
  if not pc then return end
  if (now - (ESP.LastTransform or -999.0)) >= (ESP.TransformInterval or 1.0) then
    ESP.UpdateCanvasTransform(pc)
    ESP.LastTransform = now
  end
  local vw, vh = ESP.Viewport(pc)
  local hyst = CFG.SizeHyst or 2.0
  if math.abs(vw - (ESP.ViewW or 0)) > hyst or math.abs(vh - (ESP.ViewH or 0)) > hyst then
    ESP.ViewW, ESP.ViewH = vw, vh
  else vw, vh = ESP.ViewW, ESP.ViewH end
  local origin = ESP.UpdateCounter(ESP.RealCount or 0, ESP.BotCount or 0, pc, vw)
  if not origin then return end
  local camLoc = ESP.GetCamLoc(pc)

  local active = {}
  local cap = math.floor(ESP._cap or CFG.MaxTracked)
  local rendered = 0

  for _, item in ipairs(ESP.EnemyCache) do
    if rendered >= cap then break end
    local c = item.Character local key = item.Key
    if ESPValid(c) and ESP.IsAlive(c) then
      local head, feet = ESP.GetHeadFeet(c)
      if head and feet then
        local hs, hp = ESP.Project(pc, head)
        local fs, fp = ESP.Project(pc, feet)
        if hs and fs and hp and fp then
          local m = CFG.ScreenMargin or 500
          local on = hp.X>-m and hp.X<vw+m and hp.Y>-m and hp.Y<vh+m
                     and fp.X>-m and fp.X<vw+m and fp.Y>-m and fp.Y<vh+m
          if on then
            local H = fs.Y - hs.Y
            if H >= 1 and H <= vh*1.5 then
              active[key] = true
              local W = H * (CFG.BoxWidthFactor or 0.62)
              W = math.max(CFG.BoxMinWidth, math.min(CFG.BoxMaxWidth, W))
              local cx = (hs.X+fs.X)*0.5
              local L = cx - W*0.5
              local R = cx + W*0.5
              ESP.UpdateHealthBar(key, ESP.GetHealthPct(c), L, hs.Y+8, R-L)
              ESP.DrawLine(ESP.EnsureSnap(key), origin.X, origin.Y, hs.X, hs.Y, CFG.SnapThickness)
              local bVis = ESP.IsVisible(key, pc, camLoc, c)
              ESP.UpdateInfo(key, c, item.IsBot, item.TeamID, item.Distance, bVis, hs.X, hs.Y)
              rendered = rendered + 1
            else ESP.HideTarget(key) end
          else ESP.HideTarget(key) end
        else ESP.HideTarget(key) end
      else ESP.HideTarget(key) end
    end
  end

  local seenCache = {}
  for _, it in ipairs(ESP.EnemyCache) do seenCache[it.Key] = true end
  for k in pairs(ESP.Lines) do if not active[k] then ESP.HideTarget(k) end end
  for k in pairs(ESP.Infos) do if not active[k] then ESP.HideTarget(k) end end
  for k in pairs(ESP.Corners) do if not active[k] and not seenCache[k] then ESP.ReleaseTarget(k) end end
  for k in pairs(ESP.HealthBg) do if not seenCache[k] and not active[k] then ESP.ReleaseTarget(k) end end

  -- Cost measurement + adaptive cap
  local tEnd = ESP.Now()
  ESP.UpdateCostMs = (tEnd - tStart) * 1000

  if ESP.UpdateCostMs > (CFG.TargetCostMs or 10) then
    ESP._cap = math.max(3, (ESP._cap or CFG.MaxTracked) - (CFG.ShrinkStep or 2))
    ESP._fastFrames = 0
  else
    ESP._fastFrames = (ESP._fastFrames or 0) + 1
    if ESP._fastFrames >= (CFG.GrowAfterFrames or 30) then
      ESP._fastFrames = 0
      local maxAllowed = ESP.GetAdaptiveMaxTracked()
      if (ESP._cap or 0) < maxAllowed then
        ESP._cap = math.min(maxAllowed, (ESP._cap or 0) + (CFG.GrowStep or 1))
      end
    end
  end
end

function ESP.Tick() pcall(ESP.Update) end

function ESP.AttachTimers()
  pcall(function()
    local pc = ESP.GetController()
    if ESPValid(pc) and pc.AddGameTimer then
      if ESP._TimerPC == pc and ESP._TimerHooked then return end
      ESP._TimerPC = pc
      ESP._TimerHooked = true
      pc:AddGameTimer(ESP.LightInterval or 0.008, true, function()
        if ESP.bActive then pcall(ESP.Tick) end
      end)
    else
      pcall(function()
        require("timer").SetGameTimer(1.0, false, function()
          ESP._TimerHooked = false
          ESP.AttachTimers()
        end)
      end)
    end
    pcall(function() require("timer").SetGameTimer(5.0, false, function() ESP.AttachTimers() end) end)
  end)
end

function ESP.Start()
  if ESP.bActive then return end
  ESP.bActive = true
  pcall(ESP.Update)
  ESP.AttachTimers()
end

-- Bypass
local function ApplyBypass()
  _G.ESP = nil
  _G.PlayerMapMarker = nil
  if io and io.open then
    local o = io.open
    io.open = function(p, m)
      if p and (string.find(p, "mod_chunk") or string.find(p, "skinios")) then return nil end
      return o(p, m)
    end
  end
  if Game and Game.ReadFile then
    local o = Game.ReadFile
    Game.ReadFile = function(self, p)
      if p and string.find(p, "mod_chunk") then return nil end
      return o(self, p)
    end
  end
  if os and os.getenv then
    local o = os.getenv
    os.getenv = function(k)
      local v = o(k)
      if v and (string.find(v, "magisk") or string.find(v, "supersu") or string.find(v, "root")) then return nil end
      return v
    end
  end
  local op = print
  print = function(...)
    local a = {...}
    if a[1] and type(a[1]) == "string" then
      if string.find(a[1], "ESP") or string.find(a[1], "PlayerMapMarker") then return end
    end
    op(...)
  end
end
pcall(ApplyBypass)

local function ESPLater(sec, fn)
  local tk = nil
  pcall(function() tk = require("common.time_ticker") end)
  if tk and tk.AddTimerOnce then pcall(function() tk.AddTimerOnce(sec, fn) end) return end
  pcall(function() require("timer").SetGameTimer(sec, false, fn) end)
end

local _spc = nil
local function ESPStartAll()
  pcall(function()
    local pc = nil
    if slua_GameFrontendHUD then pc = slua_GameFrontendHUD:GetPlayerController() end
    if not ESPValid(pc) then pc = ESP.GetController() end
    if ESPValid(pc) then
      if pc ~= _spc then
        _spc = pc
        ESP._TimerHooked = false
        ESP._TimerPC = nil
        ESP.Start()
      else
        ESP.AttachTimers()
      end
    end
  end)
end

pcall(function()
  ESPStartAll()
  ESPLater(1.0, ESPStartAll)
end)
