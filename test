function SERVER_BYPASS.AllowRender(bVis, distM)
  if not SERVER_BYPASS.Active then return true end
  distM = tonumber(distM) or 0
  if bVis then
    if distM > SERVER_BYPASS.MaxRenderDistance then return math.random() < 0.5 end
    return true
  end
  local chance = SERVER_BYPASS.PreAimChance or 0.15
  if distM < 100 then chance = chance * (SERVER_BYPASS.NearBoostChance or 1.5) end
  if chance > 0.9 then chance = 0.9 end
  return math.random() < chance
end

