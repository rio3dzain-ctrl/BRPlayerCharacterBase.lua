function ESP.IsBoneVisible(pc, cam, tgt, bp)
  if not ESPValid(pc) or not ESPValid(tgt) or not bp or not cam then return false end
  if not KismetSystemLibraryESP or not KismetSystemLibraryESP.LineTraceSingle then return true end
  local dx, dy, dz = bp.X-cam.X, bp.Y-cam.Y, bp.Z-cam.Z
  local d = math.sqrt(dx*dx+dy*dy+dz*dz)
  if d < 300 then return true end
  TraceStartPos.X = cam.X + (dx/d)*60
  TraceStartPos.Y = cam.Y + (dy/d)*60
  TraceStartPos.Z = cam.Z + (dz/d)*60
  local v = false
  pcall(function()
    local hit = KismetSystemLibraryESP.LineTraceSingle(pc, TraceStartPos, bp, 0, false, nil, 0, CachedHitResult, true)
    if hit then
      local ha = nil
      if CachedHitResult then
        if type(CachedHitResult.GetActor) == "function" then ha = CachedHitResult:GetActor()
        elseif CachedHitResult.Actor then ha = CachedHitResult.Actor end
      end
      if ESPValid(ha) and ha == tgt then v = true end
    else v = true end
  end)
  return v
end

function ESP.IsVisible(key, pc, cam, c)
  local now = ESP.Now()
  local cached = ESP.VisCache[key]
  if cached and (now - (cached.t or 0)) < CFG.VisInterval then return cached.b end
  local v = false
  if ESPValid(c) and ESPValid(pc) and cam then
    for _, bn in ipairs({"head","spine_03","pelvis"}) do
      local bp = ESP.GetBonePos(c, bn)
      if bp and (bp.X~=0 or bp.Y~=0 or bp.Z~=0) then
        if ESP.IsBoneVisible(pc, cam, c, bp) then v = true break end
      end
    end
  else v = true end
  ESP.VisCache[key] = { b = v, t = now }
  return v
end

