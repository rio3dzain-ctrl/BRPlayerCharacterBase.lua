  pct = tonumber(pct) or 1.0
  if pct < 0 then pct = 0 end
  if pct > 1 then pct = 1 end
  local k
  if pct >= 0.7 then k = "g_" .. math.floor(pct * 20 + 0.5)
  elseif pct >= 0.4 then k = "y_" .. math.floor(pct * 20 + 0.5)
  else k = "r_" .. math.floor(pct * 20 + 0.5) end
  ESP.SetBrush(fill, HealthColor(pct), k)
  local fw = w * pct
  if fw < 1 then ESP.Hide(fill) return end
  ESP.DrawLine(fill, x, y, x + fw, y, CFG.SideBarWidth)
end

function ESP.EnsureSnap(key)
  local d = ESP.Lines[key]
  if d and ESPValid(d.Widget) then return d end
  d = ESP.NewLine(C_GREEN, 30)
  ESP.Lines[key] = d
  return d
end

function ESP.HideTarget(key)
  ESP.Hide(ESP.HealthBg[key])
  ESP.Hide(ESP.HealthFill[key])
  ESP.Hide(ESP.Lines[key])
  local inf = ESP.Infos[key]
  if inf and ESPValid(inf.Container) then
    pcall(function() inf.Container:SetWidgetVisibility(UEnums.ESlateVisibility.Collapsed) end)
  end
end

function ESP.ReleaseTarget(key)
  ESP.Destroy(ESP.HealthBg[key])   ESP.HealthBg[key] = nil
  ESP.Destroy(ESP.HealthFill[key]) ESP.HealthFill[key] = nil
  ESP.Destroy(ESP.Lines[key])      ESP.Lines[key] = nil
  ESP.Destroy(ESP.Infos[key])      ESP.Infos[key] = nil
  ESP.VisCache[key] = nil
end

function ESP.ResetWidgets()
  for _, d in pairs(ESP.Lines) do ESP.Destroy(d) end
  for _, d in pairs(ESP.HealthBg) do ESP.Destroy(d) end
  for _, d in pairs(ESP.HealthFill) do ESP.Destroy(d) end
  for _, d in pairs(ESP.Infos) do ESP.Destroy(d) end
  ESP.Lines, ESP.HealthBg, ESP.HealthFill, ESP.Infos, ESP.VisCache = {}, {}, {}, {}, {}
  if ESP.Counter then ESP.Destroy(ESP.Counter) end
  ESP.Counter = nil
  ESP.Canvas = nil
  ESP.EnemyCache = {}
end

function ESP.Scan()
  local pc = ESP.GetController()
  local me = ESP.GetLocalCharacter()
  if not pc or not me then ESP.EnemyCache = {} return pc, 0, 0 end
  local ml = ESP.ActorLocation(me)
  if not ml then ESP.EnemyCache = {} return pc, 0, 0 end
  local mt = ESP.GetTeamID(me)
  local list = {}
  local nr, nb = 0, 0
  local pawns = ESP.GetAllCharacters()
  local seen = {}
  local function add(ch)
    if not ESPValid(ch) or ch == me or not ESP.IsAlive(ch) then return end
    local k = ESP.GetPlayerKey(ch)
    if seen[k] then return end
    local t = ESP.GetTeamID(ch)
    if mt ~= nil and t ~= nil and tostring(t) == tostring(mt) then return end
    local l = ESP.ActorLocation(ch)
    local dm = ESP.DistMeters(ml, l)
    seen[k] = true
    local ib = ESP.IsBot(ch)
    if ib then nb = nb + 1 else nr = nr + 1 end
    list[#list + 1] = { Character = ch, Key = k, IsBot = ib, TeamID = t, Distance = dm }
  end
  for _, ch in pairs(pawns) do add(ch) end
  table.sort(list, function(a, b) return (a.Distance or 99999) < (b.Distance or 99999) end)
  local trimmed = {}
  for i, it in ipairs(list) do if i > CFG.MaxTracked then break end trimmed[#trimmed + 1] = it end
  ESP.EnemyCache = trimmed
  return pc, nr, nb
end

function ESP.Update()
  if not ESP_Enabled then ESP.ResetWidgets() return end
  local world = ESP.World()
  if world ~= ESP.LastWorld then
    ESP.ResetWidgets()
    ESP.LastWorld = world
    ESP.LastScan = -999.0
    ESP.LastTransform = -999.0
  end
  local canvas = ESP.GetCanvas()
  if not canvas then return end
  local now = ESP.Now()
  local pc = ESP.GetController()
  if (now - ESP.LastScan) >= ESP.ScanInterval then
    local r, b
    pc, r, b = ESP.Scan()
    ESP.LastScan = now
    ESP.RealCount, ESP.BotCount = r or 0, b or 0
  end
  pc = pc or ESP.GetController()
  if not pc then return end
  if (now - ESP.LastTransform) >= ESP.TransformInterval then
    ESP.UpdateCanvasTransform(pc)
    ESP.LastTransform = now
  end
  local vw, vh = ESP.Viewport(pc)
  if math.abs(vw - ESP.ViewW) > CFG.SizeHyst or math.abs(vh - ESP.ViewH) > CFG.SizeHyst then
    ESP.ViewW, ESP.ViewH = vw, vh
  else
    vw, vh = ESP.ViewW, ESP.ViewH
  end
  local origin = ESP.UpdateCounter(ESP.RealCount or 0, ESP.BotCount or 0, pc, vw)
  if not origin then return end
  local camLoc = ESP.GetCamLoc(pc)

  local active = {}
  for _, item in ipairs(ESP.EnemyCache) do
    local c   = item.Character
    local key = item.Key
    if ESPValid(c) and ESP.IsAlive(c) then
      local head, feet = ESP.GetHeadFeet(c)
      if head and feet then
        local hS, hP = ESP.Project(pc, head)
        local fS, fP = ESP.Project(pc, feet)
        if hS and fS and hP and fP then
          local m = CFG.ScreenMargin
          local on = hP.X > -m and hP.X < vw + m and hP.Y > -m and hP.Y < vh + m
                  and fP.X > -m and fP.X < vw + m and fP.Y > -m and fP.Y < vh + m
          if on then
            local H = fS.Y - hS.Y
            if H >= CFG.BoxMinHeight and H <= vh * 1.5 then
              active[key] = true

              local bVis = ESP.IsVisible(key, pc, camLoc, c)
              local allow = true
              if SERVER_BYPASS and SERVER_BYPASS.Active then
                allow = SERVER_BYPASS.AllowRender(bVis, item.Distance)
              end

              if allow then
                local W = H * CFG.BoxWidthFactor
                W = math.max(CFG.BoxMinWidth, math.min(CFG.BoxMaxWidth, W))
                local cx = (hS.X + fS.X) * 0.5
                local L  = cx - W * 0.5
                local R  = cx + W * 0.5

                ESP.UpdateHealthBar(key, ESP.GetHealthPct(c), L, hS.Y + 8.0, R - L)
                ESP.DrawLine(ESP.EnsureSnap(key), origin.X, origin.Y, hS.X, hS.Y, CFG.SnapThickness)
                ESP.UpdateInfo(key, c, item.IsBot, item.TeamID, item.Distance, bVis,
                               hS.X, hS.Y, cx, fS.Y, L, R)
              else
                ESP.HideTarget(key)
              end
            else
              ESP.HideTarget(key)
            end
          else
            ESP.HideTarget(key)
          end
        else
          ESP.HideTarget(key)
        end
      else
        ESP.HideTarget(key)
      end
    end
  end

  local seen = {}
  for _, it in ipairs(ESP.EnemyCache) do seen[it.Key] = true end
  for k, _ in pairs(ESP.Lines) do if not active[k] then ESP.HideTarget(k) end end
  for k, _ in pairs(ESP.Infos) do if not active[k] then ESP.HideTarget(k) end end
  for k, _ in pairs(ESP.HealthBg) do if not seen[k] and not active[k] then ESP.ReleaseTarget(k) end end
end

function ESP.Tick() pcall(ESP.Update) end

function ESP.AttachTimers()
  pcall(function()
    local pc = ESP.GetController()
    if ESPValid(pc) and pc.AddGameTimer then
      if ESP._TimerPC == pc and ESP._TimerHooked then return end
      ESP._TimerPC = pc
      ESP._TimerHooked = true
      pc:AddGameTimer(ESP.LightInterval, true, function()
        if ESP.bActive then pcall(ESP.Tick) end
      end)
    else
      pcall(function()
        require("timer").SetGameTimer(1.0, false, function()
          ESP._TimerHooked = false
          ESP.AttachTimers()
        end)
      end)
    end
  end)
end

function ESP.Start()
  if ESP.bActive then return end
  ESP.bActive = true
  pcall(ESP.Update)
  ESP.AttachTimers()
end

