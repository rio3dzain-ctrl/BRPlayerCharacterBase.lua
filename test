function ESP.GetWorldDelta()
  local w = ESP.World()
  if GameplayStaticsESP and w and GameplayStaticsESP.GetWorldDeltaSeconds then
    local ok, dt = pcall(function() return GameplayStaticsESP.GetWorldDeltaSeconds(w) end)
    if ok and type(dt) == "number" and dt > 0.001 and dt < 0.5 then return dt end
  end
  return nil
end

function ESP.DetectDeviceFPS()
  local dt = ESP.GetWorldDelta()
  if not dt then
    -- fallback: measure between our own ticks
    local now = ESP.Now()
    if ESP._lastDeltaSample and ESP._lastDeltaSample > 0 then
      local d = now - ESP._lastDeltaSample
      if d > 0.001 and d < 0.5 then dt = d end
    end
    ESP._lastDeltaSample = now
  end
  if not dt then return nil end

  local fps = 1 / dt
  -- Snap to standard refresh rates
  if fps < 20 then fps = 15
  elseif fps < 45 then fps = 30
  elseif fps < 75 then fps = 60
  elseif fps < 105 then fps = 90
  elseif fps < 135 then fps = 120
  else fps = 144 end
  return fps
end

function ESP.GetAdaptiveMaxTracked()
  local f = ESP.DetectedFPS or 60
  if f <= 30 then return CFG.MaxTrackedLow or 10
  elseif f >= 120 then return CFG.MaxTrackedHigh or 30
  else return CFG.MaxTracked or 15 end
end

