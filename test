local function TeamColor(tid, isBot, fk)
  local n = tonumber(tid)
  if n then n = math.abs(math.floor(n))
  else
    local s = tostring(fk or "unknown")
    local h = 0
    for i = 1, #s do h = (h * 31 + string.byte(s, i)) % 2147483647 end
    n = h
  end
  return TEAM_COLORS[(n % #TEAM_COLORS) + 1]
end
local function RND(v) if v ~= v then return 0 end return math.floor(v + 0.5) end
local function Lerp(a, b, t) return a + (b - a) * t end
local function HealthColor(p)
  p = tonumber(p) or 1.0
  if p < 0 then p = 0 end
  if p > 1 then p = 1 end
  local r, g, b
  if p >= 0.7 then local t = (p - 0.7) / 0.3; r, g, b = Lerp(0.75, 0.12, t), 1.0, Lerp(0.15, 0.25, t)
  elseif p >= 0.4 then local t = (p - 0.4) / 0.3; r, g, b = 1.0, Lerp(0.45, 0.95, t), Lerp(0.45, 0.20, t)
  else local t = p / 0.4; r, g, b = 1.0, Lerp(0.15, 0.45, t), Lerp(0.15, 0.45, t) end
  return ESPMKC(r, g, b, 1.0)
end

