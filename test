end

function BRPlayerCharacterBase:IsWarGameMode()
  local gs = GameplayData:GetGameState()
  if slua.isValid(gs) and Game:IsClassOf(gs, STExtraGameStateBase) then
    return gs.GameModeType == EGameModeType.EWarGameMode
  end
  return false
end

