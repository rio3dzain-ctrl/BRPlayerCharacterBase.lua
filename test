function ESP.GetAllCharacters()
  local all = {}
  local function merge(chars)
    if not chars then return end
    for k, ch in pairs(chars) do
      if ch and slua.isValid(ch) then
        local pk = k
        pcall(function()
          if not pk and ch.GetPlayerKey then pk = ch:GetPlayerKey() end
          if not pk and ch.PlayerKey then pk = ch.PlayerKey end
        end)
        if pk then all[pk] = ch end
      end
    end
  end
  pcall(function() if Game and Game.GetAllPlayerPawns then merge(Game:GetAllPlayerPawns()) end end)
  pcall(function()
    local G = ESP.GetGameplayData()
    if G and G.GetAllCharacters then merge(G:GetAllCharacters()) end
  end)
  return all
end

