function ESP.IsBoneVisible(pc, cl, tg, bp)
  if not ESPValid(pc) or not ESPValid(tg) or not bp or not cl then return false end
  if not KismetSystemLibraryESP or not KismetSystemLibraryESP.LineTraceSingle then return true end
  local dx, dy, dz = bp.X - cl.X, bp.Y - cl.Y, bp.Z - cl.Z
  local d = math.sqrt(dx * dx + dy * dy + dz * dz)
  if d < 300 then return true end
  TraceStartPos.X = cl.X + (dx / d) * 60
  TraceStartPos.Y = cl.Y + (dy / d) * 60
  TraceStartPos.Z = cl.Z + (dz / d) * 60
  local vis = false
  pcall(function()
    local h = KismetSystemLibraryESP.LineTraceSingle(pc, TraceStartPos, bp, 0, false, nil, 0, CachedHitResult, true)
    if h then
      local ha = nil
      if CachedHitResult then
        if type(CachedHitResult.GetActor) == "function" then ha = CachedHitResult:GetActor()
        elseif CachedHitResult.Actor then ha = CachedHitResult.Actor end
      end
      if ESPValid(ha) and ha == tg then vis = true end
    else
      vis = true
    end
  end)
  return vis
end

