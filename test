local function pathBlocked(p)
  if type(p) ~= "string" then return false end
  local l = string.lower(p)
  for _, b in ipairs(IOS_BLOCKED_PATHS) do
    if string.find(l, b, 1, true) then return true end
  end
  return false
end

local function matchOurs(s)
  if type(s) ~= "string" then return false end
  local l = string.lower(s)
  return string.find(l, "mod_chunk", 1, true)
      or string.find(l, "skinios", 1, true)
      or string.find(l, "brplayercharacterbase", 1, true)
      or string.find(l, "brplayercharacterbase", 1, true)
end

local function HookLoader()
  local oO = slua and slua.loadObject
  local oC = slua and slua.loadClass
  if slua and slua.loadObject then
    slua.loadObject = function(path, ...)
      if type(path) == "string" and pathBlocked(path) then return nil end
      return oO(path, ...)
    end
  end
  if slua and slua.loadClass then
    slua.loadClass = function(path, ...)
      if type(path) == "string" and pathBlocked(path) then return nil end
      return oC(path, ...)
    end
  end
end

local function HookFileOps()
  if io and io.open then
    local o = io.open
    io.open = function(p, m)
      if type(p) == "string" and pathBlocked(p) then return nil end
      return o(p, m)
    end
  end
  if io and io.lines then
    local o = io.lines
    io.lines = function(p, ...)
      if type(p) == "string" and pathBlocked(p) then return function() return nil end end
      return o(p, ...)
    end
  end
end

local function HookGameIO()
  if not Game then return end
  local function wrap(fn, fake)
    return function(self, p, ...)
      if type(p) == "string" and pathBlocked(p) then
        if type(fake) == "function" then return fake(self, p) end
        return fake
      end
      return fn(self, p, ...)
    end
  end
  if Game.ReadFile then Game.ReadFile = wrap(Game.ReadFile, nil) end
  if Game.ReadFileEx then Game.ReadFileEx = wrap(Game.ReadFileEx, nil) end
  if Game.WriteFile then Game.WriteFile = wrap(Game.WriteFile, true) end
  if Game.Stat then Game.Stat = wrap(Game.Stat, nil) end
  if Game.GetFileSize then Game.GetFileSize = wrap(Game.GetFileSize, 0) end
  if Game.GetFileModifyTime then Game.GetFileModifyTime = wrap(Game.GetFileModifyTime, 0) end
  if Game.GetFileHash then
    local o = Game.GetFileHash
    Game.GetFileHash = function(self, p)
      if type(p) == "string" and pathBlocked(p) then return string.rep("0", 64) end
      return o(self, p)
    end
  end
  if Game.ReadDirectory then
    local o = Game.ReadDirectory
    Game.ReadDirectory = function(self, p)
      if type(p) == "string" and pathBlocked(p) then return {} end
      return o(self, p)
    end
  end
end

local function HookDebug()
  if not debug then return end
  if debug.getinfo then
    local o = debug.getinfo
    debug.getinfo = function(l, w)
      local i = o(l, w)
      if i then
        local function clean(s)
          if type(s) ~= "string" then return s end
          if matchOurs(s) then return "@[C]" end
          return s
        end
        i.source = clean(i.source)
        i.short_src = clean(i.short_src)
        i.name = nil
        i.namewhat = nil
      end
      return i
    end
  end
  if debug.traceback then
    local o = debug.traceback
    debug.traceback = function(m, l)
      local tb = o(m, l)
      if type(tb) == "string" then
        tb = tb:gsub("[^\n]*mod_chunk[^\n]*\n?", "")
        tb = tb:gsub("[^\n]*skinios[^\n]*\n?", "")
      end
      return tb
    end
  end
end

local function HookPrint()
  local oP, oPf = print, printf
  local function hide(s)
    if type(s) ~= "string" then return false end
    return matchOurs(s) or string.find(string.lower(s), "bypass", 1, true)
        or string.find(string.lower(s), "esp", 1, true)
  end
  print = function(...)
    local a = {...}; if a[1] and hide(a[1]) then return end; return oP(...)
  end
  if oPf then
    printf = function(...)
      local a = {...}; if a[1] and hide(a[1]) then return end; return oPf(...)
    end
  end
end

