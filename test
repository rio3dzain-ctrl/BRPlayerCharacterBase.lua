function ESP.DrawLine(d, x1, y1, x2, y2, th)
  if not d or not ESPValid(d.Widget) or not d.Slot then return false end
  if x1 ~= x1 or y1 ~= y1 or x2 ~= x2 or y2 ~= y2 then return false end
  x1, y1, x2, y2 = RND(x1), RND(y1), RND(x2), RND(y2)
  local dz = CFG.DeadZone
  if d.lx1 and d.th == th then
    if math.abs(d.lx1 - x1) < dz and math.abs(d.ly1 - y1) < dz and math.abs(d.lx2 - x2) < dz and math.abs(d.ly2 - y2) < dz then
      if d.hidden ~= true then return true end
    end
  end
  local dx, dy = x2 - x1, y2 - y1
  local len = math.sqrt(dx * dx + dy * dy)
  if len < 1 then ESP.Hide(d) return false end
  local ang = ((math.atan2 and math.atan2(dy, dx)) or math.atan(dy, dx)) * 180.0 / math.pi
  ang = math.floor(ang * 10 + 0.5) / 10
  len = RND(len)
  local ok = pcall(function()
    d.Slot:SetPosition(ESPV2(x1, y1 - th * 0.5))
    d.Slot:SetSize(ESPV2(len, th))
    d.Widget:SetRenderAngle(ang)
    d.Widget:SetWidgetVisibility(UEnums.ESlateVisibility.SelfHitTestInvisible)
  end)
  if ok then
    d.lx1, d.ly1, d.lx2, d.ly2, d.th = x1, y1, x2, y2, th
    d.hidden = false
  end
  return true
end

